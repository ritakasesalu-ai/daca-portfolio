--Leia tooted, mida pole kunagi müüdud.
select
  p.product_name,
  p.category,
  p.subcategory,
  p.retail_price,
  s.sale_id
FROM products p 
LEFT JOIN sales s ON p.product_id = s.product_id
WHERE s.sale_id IS NULL
--Kokku on 12 rida tooteid, mida kunagi ei ole müüdud


--Müümata tooteid kokku
select
  COUNT (*) AS müümata_tooteid
FROM products p 
LEFT JOIN sales s ON p.product_id = s.product_id
WHERE s.sale_id IS NULL;


--Enim müüdud tooted 
select
  p.product_name,
  p.category,
  p.subcategory,
  COUNT(s.sale_id) AS müüdud_kordi,
  SUM(s.total_price) AS kogumüük
FROM products p
INNER JOIN sales s ON p.product_id = s.product_id
GROUP BY p.product_id, p.product_name, p.category, p.subcategory
ORDER BY kogumüük DESC
LIMIT 10;
--Enim müüdud toode on Õhuline sünteetiline sporditossud.


--Analüüsi kategooriate kaupa
SELECT        
  p.category,        
  COUNT(DISTINCT p.product_id) AS tooteid,        
  COUNT(s.sale_id) AS müüke,        
  SUM(s.total_price) AS kogumüük    
FROM products p    
LEFT JOIN sales s ON p.product_id = s.product_id    
GROUP BY p.category    
ORDER BY kogumüük DESC;  
