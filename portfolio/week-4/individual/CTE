    SELECT
        customer_id,
        CASE
            WHEN kogukaive > 2000 THEN 'VIP'
            WHEN kogukaive > 500 THEN 'Aktiivne'
            ELSE 'Tavaline'
        END AS segment
    FROM kliendi_kokkuvote
