--Leia iga kategooria TOP 3 toodet müüdud koguse järgi.
WITH toote_edetabel AS (
    SELECT 
        p.category, 
        p.product_name, 
        SUM(s.quantity) AS kogumyyk,
        ROW_NUMBER() OVER (
            PARTITION BY p.category 
            ORDER BY SUM(s.quantity) DESC
        ) AS koht
    FROM sales s
    JOIN products p ON s.product_id = p.product_id
    GROUP BY p.category, p.product_name
)
SELECT 
    category, 
    product_name, 
    kogumyyk, 
    koht
FROM toote_edetabel
WHERE koht <= 3
ORDER BY category, koht;

--TOP 5 linna koos igakuise trendiga
WITH linna_myyk AS (
    -- CTE 1: iga linna kogumüük
    SELECT
        c.city AS linn,
        COUNT(DISTINCT s.sale_id) AS tellimusi,
        SUM(s.total_price) AS kogukaive,
        ROUND(AVG(s.total_price), 2) AS keskmine_tellimus
    FROM customers c
    JOIN sales s ON c.customer_id = s.customer_id
    WHERE s.sale_date >= '2024-01-01'
    GROUP BY c.city
    HAVING COUNT(DISTINCT s.sale_id) > 5  -- Filtreeri välja väikesed linnad
),
linna_jarjestus AS (
    -- CTE 2: lisa järjestus
    SELECT
        linn,
        tellimusi,
        kogukaive,
        keskmine_tellimus,
        ROW_NUMBER() OVER (ORDER BY kogukaive DESC) AS koht
    FROM linna_myyk
)
SELECT *
    ROUND(
        100.0 * (käive - LAG(käive) OVER (ORDER BY kuu))
        / LAG(käive) OVER (ORDER BY kuu), 1
    ) AS kasv_protsent
FROM linna_jarjestus
WHERE koht <= 5
ORDER BY koht;
--TOP 5 linna: Tallinn, Tartu, Pärnu, Narva, Viljandi


--Linnade osakaal protsentides
WITH linna_myyk AS (
    SELECT
        c.city AS linn,
        COUNT(DISTINCT s.sale_id) AS tellimusi,
        SUM(s.total_price) AS kogukaive,
        ROUND(AVG(s.total_price), 2) AS keskmine_tellimus
    FROM customers c
    JOIN sales s ON c.customer_id = s.customer_id
    WHERE s.sale_date >= '2024-01-01'
    GROUP BY c.city
    HAVING COUNT(DISTINCT s.sale_id) > 5
),
kogu_kaive AS (
    SELECT SUM(kogukaive) AS total_kaive
    FROM linna_myyk
),
linna_jarjestus AS (
    SELECT
        lm.linn,
        lm.tellimusi,
        lm.kogukaive,
        lm.keskmine_tellimus,
        ROUND( (lm.kogukaive / kk.total_kaive) * 100, 2 ) AS osakaal_protsent,
        ROW_NUMBER() OVER (ORDER BY lm.kogukaive DESC) AS koht
    FROM linna_myyk lm
    CROSS JOIN kogu_kaive kk
)
SELECT *
FROM linna_jarjestus
WHERE koht <= 5
ORDER BY koht;


--viimase kuu käive vs ülejäänud kuude keskmine
WITH linna_myyk AS (
    SELECT
        c.city AS linn,
        DATE_TRUNC('month', s.sale_date) AS kuu,
        SUM(s.total_price) AS kaive_kuus
    FROM customers c
    JOIN sales s ON c.customer_id = s.customer_id
    WHERE s.sale_date >= '2024-01-01'
    GROUP BY c.city, DATE_TRUNC('month', s.sale_date)
),
linna_koond AS (
    SELECT
        linn,
        SUM(kaive_kuus) AS kogukaive,
        COUNT(*) AS kuude_arv,
        MAX(kuu) AS viimane_kuu
    FROM linna_myyk
    GROUP BY linn
),
linna_viimase_kuu_kaive AS (
    SELECT
        lm.linn,
        lm.kaive_kuus AS viimase_kuu_kaive
    FROM linna_myyk lm
    JOIN linna_koond lk ON lm.linn = lk.linn AND lm.kuu = lk.viimane_kuu
),
linna_keskmine_ulejaanud AS (
    SELECT
        lm.linn,
        AVG(lm.kaive_kuus) AS ulejaanud_keskmine
    FROM linna_myyk lm
    JOIN linna_koond lk ON lm.linn = lk.linn
    WHERE lm.kuu < lk.viimane_kuu
    GROUP BY lm.linn
),
linna_loplik AS (
    SELECT
        lk.linn,
        lk.kogukaive,
        vk.viimase_kuu_kaive,
        uk.ulejaanud_keskmine,
        ROUND((lk.kogukaive / SUM(lk.kogukaive) OVER ()) * 100, 2) AS osakaal_protsent,
        ROW_NUMBER() OVER (ORDER BY lk.kogukaive DESC) AS koht
    FROM linna_koond lk
    JOIN linna_viimase_kuu_kaive vk ON lk.linn = vk.linn
    JOIN linna_keskmine_ulejaanud uk ON lk.linn = uk.linn
)
SELECT *
FROM linna_loplik
WHERE koht <= 5
ORDER BY koht;
