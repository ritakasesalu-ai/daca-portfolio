                'google organic',
                'google_organic'
            )
            THEN 'Google'

            -- INSTAGRAM
            WHEN LOWER(TRIM(w.source)) IN (
                'ig',
                'ig_ads',
                'instagram',
                'instagram_ads'
            )
            THEN 'Instagram'

            -- EMAIL
            WHEN LOWER(TRIM(w.source)) = 'email_campaign'
            THEN 'Email'

            -- TIKTOK
            WHEN LOWER(TRIM(w.source)) = 'tiktok'
            THEN 'TikTok'

            -- DIRECT
            WHEN LOWER(TRIM(w.source)) = 'direct'
            THEN 'Direct'

