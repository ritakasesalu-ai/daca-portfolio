            WHEN w.source IS NULL
            THEN 'Unknown'

            ELSE 'Other'

        END AS turunduskanal

    FROM customers c

    LEFT JOIN web_logs_test w
        ON c.customer_id = w.customer_id
)

SELECT

    k.turunduskanal,

    COUNT(DISTINCT c.customer_id) AS kliente,

    COUNT(DISTINCT o.sale_id) AS tellimusi,

    SUM(o.total_price) AS kogukaive,

    ROUND(
        SUM(o.total_price)
        / COUNT(DISTINCT c.customer_id),
        2
    ) AS muuk_per_klient

FROM sales o

JOIN customers c
    ON o.customer_id = c.customer_id

LEFT JOIN kanalid k
    ON c.customer_id = k.customer_id

GROUP BY k.turunduskanal

HAVING COUNT(DISTINCT o.sale_id) > 2

ORDER BY muuk_per_klient DESC;



