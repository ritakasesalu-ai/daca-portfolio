    -- laos olevate toodete arv
    COUNT(DISTINCT p.product_id) AS tooteid_laos,
    
    -- müüdud kogus kategooria kohta
    SUM(s.quantity) AS muugikogus,
    
    -- keskmine müüdud kogus ühe toote kohta
    ROUND(SUM(s.quantity) * 1.0 / COUNT(DISTINCT p.product_id), 2) AS keskmine_muuk_toote_kohta,
    
    -- hinnainfo (nagu sinu algses päringus)
    ROUND(AVG(p.retail_price), 2) AS keskmine_hind,
    MIN(p.retail_price) AS min_hind,
    MAX(p.retail_price) AS max_hind

FROM products p
LEFT JOIN sales s ON p.product_id = s.product_id

GROUP BY p.category

